# Copy this file to .env and paste your keys. Never commit .env.
# 3-key rotation ring for high-throughput experiments:

# Provider 1: Groq API (Primary)
# Get free keys (no credit card): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=

# Provider 2: Google Gemini API (Backup / Alternative)
# Get free keys (no credit card): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
